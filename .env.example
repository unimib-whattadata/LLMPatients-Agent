# Docker Compose settings
LLMPATIENTS_AGENT_IMAGE=llmpatients-agent:latest
LLMPATIENTS_AGENT_BASE_IMAGE=intel/vllm
LLMPATIENTS_AGENT_PORT=8000
LLMPATIENTS_AGENT_RENDER_GROUP=109

# Runtime settings
model_provider=local
model_id=
temperature=0.7
max_tokens=512
max_model_len=
cache_path=
# Precision/data type for local model execution ('auto', 'half', 'float16', 'bfloat16').
# Set model_dtype=half or model_dtype=float16 for Intel Arc A770 to bypass the bfloat16 accuracy issue.
model_dtype=auto

# Vertex AI settings
GCP_PROJECT=
GCP_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=config/vertex-ai-api-key.json

# Optional API settings
PSYLLM_EXPORT_TOKEN=
CLI_ARGS=

# Intel XPU settings
PYTORCH_XPU_ALLOC_CONF=max_split_size_mb:512
NEO_READ_XPU_MEM=1
ONEAPI_DEVICE_SELECTOR=level_zero:0
DONT_SET_DEVICE_MAP=1
PYTORCH_TRITON_XPU_CACHE_DIR=/tmp/triton_cache
# IPC exchange mechanism for Level Zero inside Docker ('sockets', 'pidfd', or 'drmfd').
# Set to 'sockets' to prevent 'ze_fd_manager.cpp: opendir failed' permission/device errors.
CCL_ZE_IPC_EXCHANGE=sockets

# Level Zero System Management (Sysman) and runtime performance optimizations.
# ZES_ENABLE_SYSMAN=1 allows reading telemetry and GPU resource metrics.
# Immediate command lists reduce host-side CPU overhead and command submission latency.
ZES_ENABLE_SYSMAN=1
SYCL_PI_LEVEL_ZERO_USE_IMMEDIATE_COMMANDLISTS=1
UR_L0_USE_IMMEDIATE_COMMANDLISTS=1
